# App
SECRET_KEY=change-me-in-production
APP_NAME=Jobly

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=jobly

# Redis
REDIS_URL=redis://localhost:6379/0

# Groq (free tier)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Storage (for resume PDFs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=jobly-resumes

# Gmail API OAuth2 (NOT smtp — use Google Cloud Console)
GMAIL_CLIENT_ID=your_oauth2_client_id
GMAIL_CLIENT_SECRET=your_oauth2_client_secret
GMAIL_REFRESH_TOKEN=your_oauth2_refresh_token
GMAIL_SENDER=your@gmail.com
